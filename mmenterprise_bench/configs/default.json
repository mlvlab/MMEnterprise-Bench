{
  "dataset": "data/MMEnterprise-Bench",
  "output": "outputs/eval",
  "models": [
    "luna"
  ],
  "retrievers": [
    "2b"
  ],
  "k": [
    10
  ],
  "concurrency": 8,
  "judge_concurrency": 8,
  "timeout_seconds": 180,
  "max_attempts": 5,
  "capacity_errors_as_incorrect": true,
  "model_overrides": {},
  "judge": {
    "provider": "openai",
    "model_id": "gpt-5.6-luna",
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "https://api.openai.com/v1",
    "generation": {
      "reasoning_effort": "low",
      "max_completion_tokens": 4096,
      "store": false,
      "response_format": {
        "type": "json_object"
      }
    }
  }
}
